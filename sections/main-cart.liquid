<main class="wrap" style="padding:60px 28px"><a href="{{ routes.root_url }}">Continue shopping</a><h1>Your cart</h1>{% if cart.empty? %}<p>Your cart is empty.</p>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div style="padding:20px 0;border-bottom:1px solid var(--line)"><b>{{ item.product.title | escape }}</b> {{ item.variant.title | escape }}<p>{{ item.final_line_price | money }}</p>{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}<label>Quantity <input type="number" min="0" name="updates[]" value="{{ item.quantity }}"></label></div>{% endfor %}<p>Total: {{ cart.total_price | money }}</p><button class="btn" name="update">Update cart</button> <button class="btn" name="checkout">Checkout</button></form>{% endif %}</main>