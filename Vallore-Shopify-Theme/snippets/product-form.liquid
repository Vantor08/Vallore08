{% if item != blank %}
<div id="shopify-purchase" class="native-purchase wrap narrow" style="margin:28px auto;padding:24px;background:white;border:1px solid var(--line);border-radius:14px">
<h3 style="margin-bottom:12px">Order {{ item.title | escape }}</h3>
{% form 'product', item %}
<label for="ShopifyVariant">Choose your product option</label>
<select id="ShopifyVariant" name="id" style="display:block;width:100%;padding:12px;margin:10px 0">
{% for variant in item.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}
</select>
<label for="ShopifyPlan">Purchase type</label><select name="selling_plan" id="ShopifyPlan" style="display:block;width:100%;padding:12px;margin:10px 0"><option value="">One-time purchase</option>{% for group in item.selling_plan_groups %}{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}{% endfor %}</select>
<input type="hidden" name="quantity" value="1">
<button type="submit" name="add" class="btn addcart" {% unless item.available %}disabled{% endunless %}>{% if item.available %}Add selected option to cart{% else %}Sold out{% endif %}</button>
{% endform %}
</div>{% endif %}